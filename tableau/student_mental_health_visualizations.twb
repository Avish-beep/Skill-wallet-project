          <datasource-dependencies datasource='federated.mental_health_data'>
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Depression_Flag]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Anxiety_Flag]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Panic_Attack_Flag]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane id='1'>
            <view>

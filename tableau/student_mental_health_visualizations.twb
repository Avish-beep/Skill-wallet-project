<!-- ====================================================================== -->

<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AutoCreateAndUpdateDSDPhoneLayouts />
    <IntuitiveSorting />
    <IntuitiveSorting_UI />
    <MapboxVectorStylesAndLayers />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='student_mental_health_processed' inline='true' name='federated.mental_health_data' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='student_mental_health_processed' name='textscan.mental_health_file'>
            <connection class='textscan' directory='../data/processed' filename='student_mental_health_processed.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.mental_health_file' name='student_mental_health_processed.csv' table='[student_mental_health_processed#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='User_ID' ordinal='0' />
            <column datatype='datetime' name='Timestamp' ordinal='1' />
            <column datatype='string' name='Gender' ordinal='2' />
            <column datatype='integer' name='Age' ordinal='3' />
            <column datatype='string' name='Course' ordinal='4' />
            <column datatype='string' name='Year_of_Study' ordinal='5' />
            <column datatype='string' name='CGPA_Range' ordinal='6' />
            <column datatype='string' name='Marital_Status' ordinal='7' />
            <column datatype='string' name='Depression' ordinal='8' />
            <column datatype='string' name='Anxiety' ordinal='9' />
            <column datatype='string' name='Panic_Attack' ordinal='10' />
            <column datatype='string' name='Treatment_Sought' ordinal='11' />
            <column datatype='string' name='Course_Raw' ordinal='12' />
            <column datatype='string' name='Faculty' ordinal='13' />
            <column datatype='real' name='CGPA_Midpoint' ordinal='14' />
            <column datatype='string' name='Age_Group' ordinal='15' />
            <column datatype='integer' name='Depression_Flag' ordinal='16' />
            <column datatype='integer' name='Anxiety_Flag' ordinal='17' />
            <column datatype='integer' name='Panic_Attack_Flag' ordinal='18' />
            <column datatype='integer' name='Treatment_Sought_Flag' ordinal='19' />
            <column datatype='integer' name='Condition_Count' ordinal='20' />
            <column datatype='string' name='Mental_Health_Risk' ordinal='21' />
            <column datatype='string' name='Treatment_Gap' ordinal='22' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>User_ID</remote-name>
            <remote-type>129</remote-type>
            <local-name>[User_ID]</local-name>
            <parent-name>[student_mental_health_processed.csv]</parent-name>
            <remote-alias>User_ID</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <scale>1</scale>
            <width>1073741823</width>
            <contains-null>false</contains-null>
            <collation flag='0' name='LEN_RUS' />
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Age</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Age]</local-name>
            <parent-name>[student_mental_health_processed.csv]</parent-name>
            <remote-alias>Age</remote-alias>
            <ordinal>3</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>CGPA_Midpoint</remote-name>
            <remote-type>5</remote-type>
            <local-name>[CGPA_Midpoint]</local-name>
            <parent-name>[student_mental_health_processed.csv]</parent-name>
            <remote-alias>CGPA_Midpoint</remote-alias>
            <ordinal>14</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <!-- Calculated Fields -->
      <column caption='Total Students' datatype='integer' name='[Total_Students_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([User_ID])' />
      </column>
      <column caption='High Risk Count' datatype='integer' name='[High_Risk_Count_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Mental_Health_Risk] = &apos;High Risk&apos; THEN [User_ID] END)' />
      </column>
      <column caption='High Risk %' datatype='real' default-format='p0.0%' name='[High_Risk_Pct_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[High_Risk_Count_Calc] / [Total_Students_Calc]' />
      </column>
      <column caption='Moderate Risk Count' datatype='integer' name='[Moderate_Risk_Count_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Mental_Health_Risk] = &apos;Moderate Risk&apos; THEN [User_ID] END)' />
      </column>
      <column caption='Treatment Gap Count' datatype='integer' name='[Treatment_Gap_Count_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Treatment_Gap] = &apos;Untreated Condition&apos; THEN [User_ID] END)' />
      </column>
      <column caption='Treatment Gap %' datatype='real' default-format='p0.0%' name='[Treatment_Gap_Pct_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Treatment_Gap_Count_Calc] / COUNTD(IF [Condition_Count] &gt; 0 THEN [User_ID] END)' />
      </column>
      <column caption='Depression Rate %' datatype='real' default-format='p0.0%' name='[Depression_Rate_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Depression_Flag]) / [Total_Students_Calc]' />
      </column>
      <column caption='Anxiety Rate %' datatype='real' default-format='p0.0%' name='[Anxiety_Rate_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Anxiety_Flag]) / [Total_Students_Calc]' />
      </column>
      <column caption='Panic Attack Rate %' datatype='real' default-format='p0.0%' name='[Panic_Rate_Calc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Panic_Attack_Flag]) / [Total_Students_Calc]' />
      </column>

      <!-- Standard Dimension & Measure Role Specifications -->
      <column datatype='string' name='[User_ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
      <column datatype='string' name='[Course]' role='dimension' type='nominal' />
      <column datatype='string' name='[Faculty]' role='dimension' type='nominal' />
      <column datatype='string' name='[Year_of_Study]' role='dimension' type='nominal' />
      <column datatype='string' name='[CGPA_Range]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Age_Group]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Mental_Health_Risk]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Treatment_Gap]' role='dimension' type='nominal' />
      <column datatype='string' name='[Treatment_Sought]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Condition_Count]' role='measure' type='quantitative' />
      <column datatype='real' name='[CGPA_Midpoint]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Depression_Flag]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Anxiety_Flag]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Panic_Attack_Flag]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Treatment_Sought_Flag]' role='measure' type='quantitative' />
    </datasource>
  </datasources>

  <worksheets>
    <!-- WORKSHEET 1 -->
    <worksheet name='Mental Health Risk Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='student_mental_health_processed' name='federated.mental_health_data' />
          </datasources>
          <datasource-dependencies datasource='federated.mental_health_data'>
            <column datatype='string' name='[Mental_Health_Risk]' role='dimension' type='ordinal' />
            <column caption='Total Students' datatype='integer' name='[Total_Students_Calc]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane id='1'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.mental_health_data].[Mental_Health_Risk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.mental_health_data].[Total_Students_Calc]</rows>
        <cols>[federated.mental_health_data].[Mental_Health_Risk]</cols>
      </table>
    </worksheet>

    <!-- WORKSHEET 2 -->

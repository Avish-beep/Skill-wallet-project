# Flask Application Configuration
# Copy this file to .env and insert your actual Tableau Public URLs when published.

FLASK_APP=flask_app/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-skillwallet-mental-health-2026

# Tableau Public Configuration
# Once published in Tableau Desktop (Server -> Tableau Public -> Save to Tableau Public As...),
# paste the generated public view and story URLs here:
TABLEAU_VIEW_URL=
TABLEAU_STORY_URL=
TABLEAU_TOOLBAR=bottom
TABLEAU_HIDE_TABS=false
